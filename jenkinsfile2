pipeline {
    agent any
    options {
        buildDiscarder(logRotator(
            numToKeepStr: '2',
            artifactNumToKeepStr: '2'
        ))
    }
    tools {
        jdk 'jdk17'
        maven 'maven'
    }
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Git Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/itsurvey6-lab/Ecommerce-App.git'
            }
        }
        stage('Check Tools') {
            steps {
                sh '''
                    java --version
                    mvn --version
                    docker --version
                    trivy --version
                '''
            }
        }
        stage('Maven Compile') {
            steps {
                sh 'mvn compile -B'
            }
        }

        stage('Maven Test') {
            steps {
                sh 'mvn test -B'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectKey=EcommerceApp \
                            -Dsonar.projectName=EcommerceApp \
                            -Dsonar.java.binaries=target/classes \
                            -Dsonar.exclusions="**/*.png,**/*.jpg,**/*.jpeg,**/*.webp"
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

 //       stage('OWASP Dependency Check') {
//              steps {
//                dependencyCheck(
  //                  additionalArguments: '--scan ./ --format XML --out dependency-check-report',
    //                nvdCredentialsId: 'nvd-api-key',
      //              odcInstallation: 'DP-Check'
        //        )
          //  }
//        }

  //      stage('OWASP Dependency Check Publisher') {
  //          steps {
  //              dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
//            }
  //      }

        stage('Trivy Filesystem Scan') {
            steps {
                sh 'trivy fs --exit-code 1 --severity HIGH,CRITICAL .'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ecommerce:${BUILD_NUMBER} .'
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    trivy image \
                        --exit-code 1 \
                        --severity HIGH,CRITICAL \
                        ecommerce:${BUILD_NUMBER}
                '''
            }
        }

        stage('Docker push') {
            steps {
                sh '''
                    docker tag ecommerce:${BUILD_NUMBER} itsurvey6/ecommerceapp:${BUILD_NUMBER}
                    docker push itsurvey6/ecommerceapp:${BUILD_NUMBER}
                '''
            }
        }

        stage('Curl Test') {
            steps {
                 sh '''
                    curl --fail --max-time 30 \
                    http://localhost:8081/EcommerceApp/
                 '''
            }
        }
    }
}